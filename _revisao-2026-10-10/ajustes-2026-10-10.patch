diff -ruN '--exclude=ultimo-resultado.json' '--exclude=.augpt' augpt-original/avaliacao/casos/erros-temporarios.js augpt/avaliacao/casos/erros-temporarios.js
--- a/avaliacao/casos/erros-temporarios.js	1969-12-31 21:00:00.000000000 -0300
+++ b/avaliacao/casos/erros-temporarios.js	2026-10-10 10:33:01.417152157 -0300
@@ -0,0 +1,143 @@
+'use strict';
+
+/**
+ * Erro temporário × definitivo (2026-10-10, tools/erros.js): leitura que
+ * falha por motivo passageiro e rápido (429, 5xx, conexão derrubada) tenta de
+ * novo uma vez; erro definitivo (404, 403, endereço bloqueado, arquivo que
+ * não existe) volta ao modelo dizendo que repetir não adianta.
+ */
+
+const http = require('http');
+const { classificarErro, comNovaTentativa, anotarErro, MARCA_DEFINITIVO } = require('../../src/tools/erros');
+const { executarCasoAgente } = require('../motor');
+
+/** Servidor que responde a sequência de status dada, um por pedido (o último se repete). */
+async function servidorDeStatus(sequencia, corpo) {
+  let n = 0;
+  const s = http.createServer((req, res) => {
+    const status = sequencia[Math.min(n, sequencia.length - 1)];
+    n += 1;
+    res.statusCode = status;
+    res.setHeader('Content-Type', 'text/html');
+    res.end(status === 200 ? corpo : `erro ${status}`);
+  });
+  await new Promise((r) => s.listen(0, '127.0.0.1', r));
+  return { url: `http://127.0.0.1:${s.address().port}/artigo`, pedidos: () => n, fechar: () => new Promise((r) => s.close(r)) };
+}
+
+const ARTIGO =
+  '<html><body><article><p>O PUBG foi lançado em março de 2017 em acesso antecipado. ' +
+  'Contexto suficiente para o extrator aceitar este bloco como conteúdo de verdade, com mais de cem caracteres.</p></article></body></html>';
+
+module.exports = [
+  {
+    nome: 'erros: classificação — 404 e "não existe" são definitivos; 503 e "socket hang up" repetem; timeout e "nenhum provedor" são temporários mas não repetem',
+    tipo: 'unidade',
+    executar() {
+      const c = (m) => classificarErro(new Error(m));
+      return [
+        c('Não consegui ler a página. Tentativas — html direto: HTTP 404 | render-js: timeout').tipo === 'definitivo' || '404 junto de timeout é definitivo',
+        c('Bloqueado: 192.168.0.1 é endereço da rede local').tipo === 'definitivo' || 'endereço bloqueado é definitivo',
+        c('Arquivo "relatorio.pdf" não existe na pasta de trabalho').tipo === 'definitivo' || 'arquivo inexistente é definitivo',
+        c('HTTP 503').repetivel === true || '503 repete',
+        c('socket hang up').repetivel === true || 'conexão derrubada repete',
+        c('timeout').tipo === 'temporario' && c('timeout').repetivel === false || 'timeout é temporário mas não repete (custaria outro timeout)',
+        c('Nenhum provedor de busca respondeu. Detalhes — searxng: HTTP 503').repetivel === false || 'a cadeia de provedores já tentou todos',
+        c('algo estranho aconteceu').tipo === 'desconhecido' || 'texto sem sinal nenhum fica desconhecido',
+        anotarErro('HTTP 404', c('HTTP 404')).includes(MARCA_DEFINITIVO) || 'definitivo ganha a marca para o modelo',
+        anotarErro('timeout', c('timeout')) === 'timeout' || 'temporário sem nova tentativa não ganha marca',
+      ];
+    },
+  },
+  {
+    nome: 'erros: comNovaTentativa — 503 passa na 2ª; 404 não repete; tentativa lenta não repete; interrupção para na hora',
+    tipo: 'unidade',
+    async executar() {
+      let n1 = 0;
+      const ok = await comNovaTentativa(
+        async () => {
+          n1 += 1;
+          if (n1 === 1) throw new Error('HTTP 503');
+          return 'conteúdo';
+        },
+        { esperaMs: 1 }
+      );
+      let n2 = 0;
+      let def = null;
+      try {
+        await comNovaTentativa(async () => {
+          n2 += 1;
+          throw new Error('HTTP 404');
+        }, { esperaMs: 1 });
+      } catch (err) {
+        def = err;
+      }
+      let n3 = 0;
+      try {
+        await comNovaTentativa(async () => {
+          n3 += 1;
+          await new Promise((r) => setTimeout(r, 30));
+          throw new Error('HTTP 503');
+        }, { esperaMs: 1, maxDuracaoMs: 10 });
+      } catch {
+        /* esperado */
+      }
+      const ctrl = new AbortController();
+      let n4 = 0;
+      try {
+        await comNovaTentativa(async () => {
+          n4 += 1;
+          ctrl.abort(new Error('interrompido'));
+          throw new Error('HTTP 503');
+        }, { esperaMs: 1, signal: ctrl.signal });
+      } catch {
+        /* esperado */
+      }
+      return [
+        ok === 'conteúdo' && n1 === 2 || `503: ${n1} tentativa(s)`,
+        n2 === 1 || `404 foi repetido (${n2})`,
+        def?.classificacao?.tipo === 'definitivo' || 'o erro sai com a classificação',
+        n3 === 1 || `tentativa lenta foi repetida (${n3})`,
+        n4 === 1 || `interrompido e mesmo assim repetiu (${n4})`,
+      ];
+    },
+  },
+  {
+    nome: 'erros (ponta a ponta): abrir_pagina com 503 na 1ª vez lê na 2ª; com 404 o erro volta marcado como definitivo e não é repetido',
+    tipo: 'unidade',
+    async executar() {
+      const instavel = await servidorDeStatus([503, 200], ARTIGO);
+      const sumiu = await servidorDeStatus([404], 'x');
+      try {
+        const a = await executarCasoAgente({
+          nome: 'erros: 503',
+          pedido: 'Leia a página e me diga quando o PUBG foi lançado',
+          roteiro: [
+            { ferramenta: 'abrir_pagina', argumentos: { url: instavel.url } },
+            { ferramenta: 'responder', argumentos: { foco: 'pubg' } },
+          ],
+          redacao: 'Em março de 2017.',
+        });
+        const b = await executarCasoAgente({
+          nome: 'erros: 404',
+          pedido: 'Leia a página e me diga quando o PUBG foi lançado',
+          roteiro: [
+            { ferramenta: 'abrir_pagina', argumentos: { url: sumiu.url } },
+            { ferramenta: 'responder', argumentos: { foco: 'pubg' } },
+          ],
+          redacao: 'Não consegui ler a página.',
+        });
+        return [
+          instavel.pedidos() >= 2 || `o 503 deveria ter sido tentado de novo (${instavel.pedidos()} pedido(s))`,
+          !a.erros.some((e) => /abrir_pagina/.test(e)) || `a 2ª tentativa deveria ter lido: ${a.erros.join(' / ')}`,
+          /2017/.test(a.promptRedacao) || 'o conteúdo lido na 2ª tentativa tem que chegar à redação',
+          b.erros.some((e) => e.includes('erro definitivo')) || `o 404 deveria voltar marcado: ${b.erros.join(' / ')}`,
+          sumiu.pedidos() <= 2 || `404 não deveria ser repetido pela ferramenta (${sumiu.pedidos()} pedidos)`,
+        ];
+      } finally {
+        await instavel.fechar();
+        await sumiu.fechar();
+      }
+    },
+  },
+];
diff -ruN '--exclude=ultimo-resultado.json' '--exclude=.augpt' augpt-original/avaliacao/casos/retomada.js augpt/avaliacao/casos/retomada.js
--- a/avaliacao/casos/retomada.js	1969-12-31 21:00:00.000000000 -0300
+++ b/avaliacao/casos/retomada.js	2026-10-10 10:23:30.279019635 -0300
@@ -0,0 +1,124 @@
+'use strict';
+
+/**
+ * Retomada de execução interrompida (2026-10-10): páginas baixadas e
+ * destilações da execução anterior INTERROMPIDA da mesma conversa são
+ * reaproveitadas; execução anterior concluída limpa tudo. Ver src/agent/retomada.js.
+ */
+
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { Retomada } = require('../../src/agent/retomada');
+const { executarCasoAgente } = require('../motor');
+const { buscaFalsa, pagina } = require('../fixtures/busca-falsa');
+
+const tmp = () => fs.mkdtempSync(path.join(os.tmpdir(), 'augpt-retomada-'));
+const INTERROMPIDA = { estado: 'executando', subtarefas: [] };
+
+module.exports = [
+  {
+    nome: 'retomada: guarda e relê página e destilação; o que passou de 12h expira; limpar apaga o arquivo; id de conversa vira nome seguro',
+    tipo: 'unidade',
+    executar() {
+      const dir = tmp();
+      let agora = 1_000_000;
+      const r = new Retomada({ dir, idConversa: '../c:1', agora: () => agora });
+      r.guardarPagina('https://site.com/a?utm=x#y', { texto: 'conteúdo A', titulo: 'A', via: 'direto', tentativas: [{ x: 1 }] });
+      r.guardarPagina('https://site.com/vazia', { texto: '' });
+      const chave = Retomada.chaveDestilacao({ objetivo: 'o', foco: 'f', opcao: '', texto: 'conteúdo A' });
+      r.guardarDestilacao(chave, [{ texto: 'fato 1', origem: 'pesquisar_e_ler(site.com)' }]);
+      const arquivos = fs.readdirSync(path.join(dir, 'retomada'));
+      const relida = new Retomada({ dir, idConversa: '../c:1', agora: () => agora }).carregar();
+      const pag = relida.pagina('https://site.com/a?outro=1');
+      agora += 13 * 60 * 60 * 1000;
+      const expirada = new Retomada({ dir, idConversa: '../c:1', agora: () => agora }).carregar();
+      const destilacaoRelida = relida.destilacao(chave)?.[0]?.texto;
+      const vazia = relida.pagina('https://site.com/vazia');
+      const outroObjetivo = relida.destilacao(Retomada.chaveDestilacao({ objetivo: 'outro pedido', foco: 'f', opcao: '', texto: 'conteúdo A' }));
+      relida.limpar();
+      return [
+        arquivos.length === 1 && !/[./:]/.test(arquivos[0].replace(/\.json$/, '')) || `nome do arquivo: ${arquivos}`,
+        pag?.texto === 'conteúdo A' || `página relida: ${JSON.stringify(pag)}`,
+        pag && !pag.tentativas || 'diagnóstico da leitura original não vai pro disco',
+        vazia === null || 'página sem texto não é guardada',
+        destilacaoRelida === 'fato 1' || 'destilação relida',
+        outroObjetivo === null || 'outro objetivo não reaproveita a destilação',
+        expirada.vazia || 'depois de 12h nada deveria ser retomado',
+        !fs.existsSync(path.join(dir, 'retomada', arquivos[0])) || 'limpar() deveria apagar o arquivo',
+      ];
+    },
+  },
+  {
+    nome: 'retomada (ponta a ponta): execução interrompida → a seguinte na mesma conversa não baixa de novo as páginas; execução anterior concluída → começa do zero',
+    tipo: 'unidade',
+    async executar() {
+      const srv = await buscaFalsa([
+        {
+          contem: 'historia do pubg',
+          paginas: [
+            pagina('O PUBG foi lançado em março de 2017 em acesso antecipado pela Bluehole.'),
+            pagina('A versão 1.0 do PUBG saiu em dezembro de 2017 no PC.'),
+          ],
+        },
+      ]);
+      if (!srv) return [];
+      const caso = (extra) => ({
+        nome: 'retomada: pubg',
+        pedido: 'Qual a história do lançamento do PUBG?',
+        idConversa: 'conversa-retomada',
+        manterPasta: true,
+        config: { searxngUrl: `http://127.0.0.1:${srv.porta}`, permitirLeitorExterno: false, subconsultas: false },
+        roteiro: [
+          { ferramenta: 'pesquisar_e_ler', argumentos: { consulta: 'historia do pubg' } },
+          { ferramenta: 'responder', argumentos: { foco: 'pubg' } },
+        ],
+        redacao: 'Resposta de teste.',
+        ...extra,
+      });
+      try {
+        const primeira = await executarCasoAgente(caso({ manterPasta: false }));
+        const segunda = await executarCasoAgente(caso({ tarefaAnterior: INTERROMPIDA }));
+        const terceira = await executarCasoAgente(caso({ tarefaAnterior: null }));
+        const r1 = primeira.registro?.retomada;
+        const r2 = segunda.registro?.retomada || {};
+        const r3 = terceira.registro?.retomada;
+        return [
+          !r1 || (r1.paginasUsadas === 0 && r1.destilacoesUsadas === 0) || `a 1ª execução não tinha o que retomar: ${JSON.stringify(r1)}`,
+          r2.disponiveis?.paginas >= 2 || `a 2ª deveria encontrar as páginas da 1ª: ${JSON.stringify(r2)}`,
+          r2.paginasUsadas >= 2 || `a 2ª deveria reaproveitar as 2 páginas: ${JSON.stringify(r2)}`,
+          r2.destilacoesUsadas >= 2 || `a 2ª deveria reaproveitar as destilações: ${JSON.stringify(r2)}`,
+          /2017/.test(segunda.promptRedacao) || 'o material retomado tem que chegar à redação',
+          !r3 || (r3.paginasUsadas === 0 && r3.destilacoesUsadas === 0) || `anterior concluída: nada a retomar (${JSON.stringify(r3)})`,
+        ];
+      } finally {
+        await srv.fechar();
+      }
+    },
+  },
+  {
+    nome: 'retomada: arquivo lido da pasta de trabalho não vai para o cache de retomada (só leitura da web pública)',
+    tipo: 'unidade',
+    async executar() {
+      const obtido = await executarCasoAgente({
+        nome: 'retomada: arquivo',
+        pedido: 'Leia notas.txt e me diga o valor da multa',
+        idConversa: 'conversa-arquivo',
+        arquivos: { 'notas.txt': 'A multa por cancelamento é de R$ 350,00 conforme a cláusula 7.' },
+        roteiro: [
+          { ferramenta: 'ler_arquivo', argumentos: { caminho: 'notas.txt' } },
+          { ferramenta: 'responder', argumentos: { foco: 'multa' } },
+        ],
+        redacao: 'A multa é de R$ 350,00.',
+      });
+      // mesma pasta que avaliacao/motor.js (prepararPasta) monta para o caso
+      const pasta = path.join(os.tmpdir(), 'augpt-avaliacao', 'retomada-arquivo', '.augpt', 'retomada');
+      const conteudo = fs.existsSync(pasta) ? fs.readdirSync(pasta).map((n) => fs.readFileSync(path.join(pasta, n), 'utf8')).join('') : '';
+      return [
+        obtido.ferramentasChamadas.includes('ler_arquivo') || 'cenário: o arquivo deveria ter sido lido',
+        /350/.test(obtido.promptRedacao) || 'cenário: o conteúdo do arquivo deveria chegar à redação',
+        !/350/.test(conteudo) || 'o conteúdo do arquivo do usuário foi parar no cache de retomada',
+      ];
+    },
+  },
+];
diff -ruN '--exclude=ultimo-resultado.json' '--exclude=.augpt' augpt-original/avaliacao/casos/roteador.js augpt/avaliacao/casos/roteador.js
--- a/avaliacao/casos/roteador.js	1969-12-31 21:00:00.000000000 -0300
+++ b/avaliacao/casos/roteador.js	2026-10-10 10:16:56.551028640 -0300
@@ -0,0 +1,210 @@
+'use strict';
+
+/**
+ * Roteador híbrido (2026-10-10): regra de código + modelo de decisão (Tev1).
+ * Ver src/agent/roteador.js. Os casos usam um decisor falso — a bancada não
+ * depende do Ollama real nem do Tev1 instalado.
+ */
+
+const fs = require('fs');
+const path = require('path');
+const ollama = require('../../src/llm/ollama');
+const { decidirRota, combinar } = require('../../src/agent/roteador');
+const { tipoDoPedido } = require('../../src/agent/tipo-de-pedido');
+const mp = require('../../src/agent/motor-pesquisa');
+const { executarCasoAgente } = require('../motor');
+
+const TCP = 'O que é o protocolo TCP three-way handshake? Qual a diferença entre um switch e um roteador?';
+const TESLA = 'Me conte quem foi nicola tesla e quais foram as invenções mais importantes que ele criou ?';
+const ligado = { roteadorDecisor: true, modeloDecisor: 'tev1', limiarDecisor: 0.6 };
+const decisorQueDiz = (valor, confidence) => async () => ({ rota: { choice: valor, confidence, probabilities: { [valor]: confidence } } });
+
+module.exports = [
+  {
+    nome: 'roteador: com confiança ≥ limite o decisor troca a rota da regra (TCP: regra dizia produto, vira explicação)',
+    tipo: 'unidade',
+    async executar() {
+      const regra = tipoDoPedido(TCP).tipo;
+      const r = await decidirRota(TCP, { config: ligado, decidir: decisorQueDiz('explicacao', 0.9) });
+      return [
+        regra === 'produto' || `cenário: a regra deveria errar este pedido (deu ${regra})`,
+        r.tipo === 'explicacao' || `tipo: ${r.tipo}`,
+        r.fonte === 'decisor' || `fonte: ${r.fonte}`,
+        r.tipoDaRegra === 'produto' || `tipoDaRegra: ${r.tipoDaRegra}`,
+        mp.ehPedidoDeRecomendacao(TCP) === true || 'sem rota, o motor continua achando que é recomendação (comportamento antigo)',
+        mp.ehPedidoDeRecomendacao(TCP, { rota: r }) === false || 'com a rota do decisor, explicação não abre o motor de produto',
+      ];
+    },
+  },
+  {
+    nome: 'roteador: confiança abaixo do limite fica com a regra; decisor desligado nem é chamado',
+    tipo: 'unidade',
+    async executar() {
+      const baixa = await decidirRota(TESLA, { config: ligado, decidir: decisorQueDiz('explicacao', 0.4) });
+      let chamou = false;
+      const desligado = await decidirRota(TESLA, {
+        config: { ...ligado, roteadorDecisor: false },
+        decidir: async () => {
+          chamou = true;
+          return {};
+        },
+      });
+      return [
+        baixa.tipo === tipoDoPedido(TESLA).tipo || `confiança 0,4 trocou a rota: ${baixa.tipo}`,
+        baixa.fonte === 'regra' || `fonte: ${baixa.fonte}`,
+        baixa.decisor?.confianca === 0.4 || 'a decisão ignorada continua registrada (para medir depois)',
+        !chamou || 'desligado não pode chamar o modelo',
+        desligado.fonte === 'regra' || `fonte: ${desligado.fonte}`,
+      ];
+    },
+  },
+  {
+    nome: 'roteador: arquivo (local) e site com endereço nunca são trocados pelo modelo; "site" do modelo sem endereço é ignorado',
+    tipo: 'unidade',
+    async executar() {
+      const local = 'leia o contrato.pdf da pasta de trabalho e me diga as multas';
+      const site = 'entre em https://loja.exemplo.com com meu login e clique em rastrear pedido';
+      let chamadas = 0;
+      const contar = async () => {
+        chamadas += 1;
+        return { rota: { choice: 'produto', confidence: 0.99 } };
+      };
+      const rLocal = await decidirRota(local, { config: ligado, decidir: contar });
+      const rSite = await decidirRota(site, { config: ligado, decidir: contar });
+      const rSiteDoModelo = combinar({ tipo: 'livre', motivo: 'x' }, { valor: 'site', confianca: 0.99 });
+      return [
+        rLocal.tipo === 'local' || `local: ${rLocal.tipo}`,
+        rSite.tipo === 'site' || `site: ${rSite.tipo}`,
+        chamadas === 0 || `regra exata não deveria gastar chamada ao modelo (${chamadas})`,
+        rSiteDoModelo.tipo === 'livre' || `"site" do modelo sem endereço: ${rSiteDoModelo.tipo}`,
+      ];
+    },
+  },
+  {
+    nome: 'roteador: erro ou demora do modelo de decisão cai na regra, com o motivo guardado; interrupção do usuário propaga',
+    tipo: 'unidade',
+    async executar() {
+      const r = await decidirRota(TESLA, {
+        config: ligado,
+        decidir: async () => {
+          throw new Error('Ollama 404: model "tev1" not found');
+        },
+      });
+      const ctrl = new AbortController();
+      ctrl.abort(new Error('interrompido'));
+      let propagou = false;
+      try {
+        await decidirRota(TESLA, {
+          config: ligado,
+          signal: ctrl.signal,
+          decidir: async () => {
+            throw new Error('interrompido');
+          },
+        });
+      } catch {
+        propagou = true;
+      }
+      return [
+        r.fonte === 'regra' || `fonte: ${r.fonte}`,
+        /not found/.test(r.falhaDoDecisor || '') || `falhaDoDecisor: ${r.falhaDoDecisor}`,
+        propagou || 'interrupção pelo usuário não pode virar "cai na regra e segue"',
+      ];
+    },
+  },
+  {
+    nome: 'roteador: modoDaPesquisa com rota do decisor — produto vira recomendação, guia vira guia, tarefa sai do motor; rota da regra não muda nada',
+    tipo: 'unidade',
+    executar() {
+      const p = 'Fale sobre o Simgot EM6L para jogar';
+      const doDecisor = (tipo) => ({ tipo, fonte: 'decisor' });
+      const recomendacao = 'Quais os melhores fones intra-auriculares para jogar PUBG no PC?';
+      return [
+        mp.modoDaPesquisa(p, { rota: doDecisor('produto') }) === 'recomendacao' || 'produto do decisor → recomendação',
+        mp.modoDaPesquisa(p, { rota: doDecisor('guia') }) === 'guia' || 'guia do decisor → guia',
+        mp.modoDaPesquisa(recomendacao, { rota: doDecisor('livre') }) === null || 'tarefa do decisor tira do motor',
+        mp.modoDaPesquisa(recomendacao, { rota: { tipo: 'produto', fonte: 'regra' } }) === mp.modoDaPesquisa(recomendacao) || 'rota da regra = comportamento de sempre',
+      ];
+    },
+  },
+  {
+    nome: 'roteador (pedidos reais de 08/10): a política escolhida acerta mais que as regras sozinhas nas decisões gravadas do tev1',
+    tipo: 'unidade',
+    executar() {
+      // os pedidos reais e o resultado ficam fora do Git (avaliacao/decisores/.gitignore)
+      const pasta = path.join(__dirname, '..', 'decisores');
+      const arqResultado = fs.existsSync(pasta) && fs.readdirSync(pasta).filter((n) => /^resultado-.*\.json$/.test(n)).sort().pop();
+      if (!arqResultado || !fs.existsSync(path.join(pasta, 'pedidos-reais.json'))) return [true];
+      const resultado = JSON.parse(fs.readFileSync(path.join(pasta, arqResultado), 'utf8'));
+      const linhas = resultado.detalhes?.tev1;
+      if (!Array.isArray(linhas)) return [true];
+      const pedidos = [path.join(pasta, 'pedidos-reais.json'), path.join(pasta, 'pedidos-extras.json')]
+        .filter((f) => fs.existsSync(f))
