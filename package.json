{
  "name": "augpt",
  "version": "0.40.0",
  "description": "Agente autônomo para desktop que planeja, pesquisa na web, lê e gera documentos — com o modelo de IA rodando no seu computador via Ollama.",
  "main": "electron/main.js",
  "author": "Davi",
  "license": "MIT",
  "keywords": [
    "agente",
    "ia-local",
    "ollama",
    "electron",
    "llm",
    "autogpt",
    "pt-br"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "fumaca": "node avaliacao/tela/fumaca.js --pesquisa",
    "dist": "electron-builder",
    "avaliar": "node avaliacao/executar.js",
    "comparar": "node avaliacao/comparar.js",
    "qualidade": "node avaliacao/qualidade.js",
    "qualidade:app": "electron avaliacao/qualidade.js",
    "qualidade:agendar": "node avaliacao/agendar-qualidade.js",
    "atualizar-dominios": "node ferramentas/_atualizar-dominios.js"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.davi.augpt",
    "productName": "AuGPT",
    "files": [
      "electron/**/*",
      "src/**/*",
      "renderer/**/*",
      "skills/**/*",
      "ferramentas/**/*",
      "dados/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "AuGPT-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "D4v1K1ngg",
      "repo": "augpt",
      "releaseType": "release"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
